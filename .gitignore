# secrets — never commit
.env*
.secrets/
*.jks
*.p12
*.keystore
key.properties

# build outputs
out/
.vcpkg-bin/
vcpkg_installed/
build/
.dart_tool/

# per-package lockfiles (packages are libraries)
packages/*/pubspec.lock

# Dart tooling
.dart_tool/

# Golden test diffs (written when a golden fails)
**/goldens/failures/
