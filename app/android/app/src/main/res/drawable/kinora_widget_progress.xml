<?xml version="1.0" encoding="utf-8"?>
<!-- How far into a video: lime on a dim track. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape><solid android:color="#33FFFFFF" /><corners android:radius="2dp" /></shape>
    </item>
    <item android:id="@android:id/progress">
        <clip><shape><solid android:color="#BEF264" /><corners android:radius="2dp" /></shape></clip>
    </item>
</layer-list>
